DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST.neon.tech/neondb?sslmode=require"
AUTH_SECRET="run: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
# Server routing (proxy.ts): hostname label used to parse tenant subdomains from the real
# incoming Host header — no port. Dev: "localhost" so "acme.localhost" resolves tenant "acme".
ROOT_DOMAIN="localhost"
# Display-only (super-admin UI): tenant URL suffix as {slug}.{domain}. Dev: localhost:3000
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
# Optional branding on login, sidebar, and employee screens (defaults to PayRun).
NEXT_PUBLIC_COMPANY_NAME="PayRun"
# Optional — welcome emails when provisioning staff (pick Resend OR SMTP, not both required)
#
# --- Resend (recommended) https://resend.com ---
# 1. Sign up → API Keys → Create API Key
# 2. Paste key below and restart: npm run dev
# 3. Sandbox (no domain verify): FROM must be onboarding@resend.dev (default below).
#    You can only send TO the email you used to sign up for Resend until you verify a domain.
# 4. Production: verify your domain at resend.com/domains, then set MAIL_FROM to e.g.
#    PayRun <onboarding@yourdomain.com>
RESEND_API_KEY=""
MAIL_FROM="PayRun <onboarding@resend.dev>"
#
# --- Gmail SMTP (alternative) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your@gmail.com"
# SMTP_PASS="your-gmail-app-password"
# SMTP_FROM="PayRun <your@gmail.com>"

// Employee Hours — PostgreSQL (Neon recommended). Use pooled DATABASE_URL + direct DIRECT_URL for migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  websiteUrl   String?  @map("website_url")
  logoUrl      String?  @map("logo_url")
  primaryColor String?  @map("primary_color")
  /// IANA timezone for pay-period date boundaries (e.g. America/Toronto).
  timezone     String   @default("America/Toronto")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users     User[]
  employees Employee[]
  payPeriods PayPeriod[]
}

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  contactEmail      String    @unique @map("contact_email")
  passwordHash      String
  name              String
  role              String // SUPER_ADMIN | MAIN_ADMIN | MANAGER | SUPERVISOR | EMPLOYEE (legacy ADMIN → migrated to MAIN_ADMIN)
  phone             String?
  tokenVersion      Int       @default(0) @map("token_version")
  /// When true, user must set a new password before using the app (provisioning / reset).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  /// Email OTP for super-admin two-step login (legacy; superseded by TOTP).
  loginOtpCode       String?   @map("login_otp_code")
  loginOtpExpires    DateTime? @map("login_otp_expires")
  /// AES-GCM encrypted TOTP secret (base32) for admin portal authenticator apps.
  totpSecretEnc      String?   @map("totp_secret_enc")
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  /// When set, staff cannot sign in (temporary suspension). Cleared on restore.
  deletedAt          DateTime? @map("deleted_at")
  createdById       String?   @map("created_by_id")
  createdBy         User?     @relation("ManagerAccountsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  managersCreated   User[]    @relation("ManagerAccountsCreatedBy")
  /// Nullable only for SUPER_ADMIN (cross-tenant); enforced at the application layer, see lib/roles.ts.
  companyId         String?   @map("company_id")
  company           Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee            Employee[]
  assignedEmployees    Employee[] @relation("EmployeeAssignedManager")
  supervisedEmployees  Employee[] @relation("EmployeeAssignedSupervisor")
  notifications        Notification[]
  auditLogs             AuditLog[] @relation("ActorAuditLogs")
  approvals             Approval[]

  @@index([companyId])
}

model Employee {
  id             String    @id @default(cuid())
  employeeCode   String    @unique @map("employee_id")
  username       String
  name           String
  contactEmail   String    @map("contact_email")
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyId      String?   @map("company_id")
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// When set, this row was auto-created in the target company from the source employee.
  mirroredFromEmployeeId String?   @map("mirrored_from_employee_id")
  mirroredFromEmployee   Employee? @relation("EmployeeMirror", fields: [mirroredFromEmployeeId], references: [id], onDelete: SetNull)
  mirrorCopies           Employee[] @relation("EmployeeMirror")
  managerUserId  String?   @map("manager_user_id")
  managerUser    User?     @relation("EmployeeAssignedManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  supervisorId   String?   @map("supervisor_id")
  supervisor     User?     @relation("EmployeeAssignedSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  hourlyRate     Float     @default(28)
  overtimeRate   Float     @default(42)
  department     String?
  jobTitle       String?
  isApproved     Boolean   @default(true) @map("is_approved")
  emailVerified  Boolean   @default(false) @map("email_verified")
  otpCode        String?   @map("otp_code")
  otpExpires     DateTime? @map("otp_expires")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timesheets Timesheet[]
  payslips   Payslip[]

  @@unique([companyId, contactEmail])
  @@unique([companyId, username])
  @@index([deletedAt])
  @@index([isApproved])
  @@index([companyId])
  @@index([userId])
  @@index([managerUserId])
  @@index([supervisorId])
  @@index([mirroredFromEmployeeId])
}

model PayPeriod {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String?
  startDate DateTime
  endDate   DateTime
  status    String   @default("OPEN") // OPEN | CLOSED | PROCESSING
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timesheets Timesheet[]
  payslips   Payslip[]

  @@unique([companyId, startDate, endDate])
  @@index([companyId, isCurrent])
  @@index([startDate, endDate])
}

model Timesheet {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payPeriodId   String
  payPeriod     PayPeriod @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  status        String    @default("DRAFT") // DRAFT | PENDING | UNDER_REVIEW | APPROVED | REJECTED
  notes         String?
  totalRegular  Float     @default(0)
  totalOvertime Float     @default(0)
  totalLeave    Float     @default(0)
  totalHours    Float     @default(0)
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entries   TimesheetEntry[]
  approvals Approval[]
  payslip   Payslip?

  @@unique([employeeId, payPeriodId])
}

model TimesheetEntry {
  id            String    @id @default(cuid())
  timesheetId   String
  timesheet     Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  workDate      DateTime
  regularHours  Float     @default(0)
  overtimeHours Float     @default(0)
  leaveHours    Float     @default(0)
  location      String?
  notes         String?

  @@unique([timesheetId, workDate])
  @@index([timesheetId])
}

model Approval {
  id              String   @id @default(cuid())
  timesheetId     String
  timesheet       Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  adminId         String
  admin           User      @relation(fields: [adminId], references: [id])
  previousStatus  String?
  newStatus       String
  comment         String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
}

model Payslip {
  id              String    @id @default(cuid())
  payslipNumber   String    @unique
  timesheetId     String    @unique
  timesheet       Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  payPeriodId     String
  payPeriod       PayPeriod @relation(fields: [payPeriodId], references: [id])

  hourlyRate      Float
  overtimeRate    Float
  jobTitle        String?   @map("job_title")
  department      String?   @map("department")
  regularHours    Float
  overtimeHours   Float
  grossPay        Float
  totalDeductions Float
  netPay          Float
  approvalDate    DateTime?
  adminSignoff    String?

  markedSentAt DateTime?
  emailSentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayslipItem[]
}

model PayslipItem {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  label     String
  amount    Float
  type      String // EARNING | DEDUCTION
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  metadata  String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  teamSize  String?  @map("team_size")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Daily API request counter (incremented fire-and-forget in proxy.ts). Rows older than 90 days
/// can be safely pruned via an optional cron — not required for correctness since `date` is the key.
model UsageDaily {
  date         DateTime @id @db.Date
  requestCount Int      @default(0) @map("request_count")
}

